# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Voting Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/voting_system_db"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_LOGGING=false

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRY="7d"
REFRESH_TOKEN_EXPIRY="30d"
SESSION_TIMEOUT="24h"

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@votingsystem.com"
SMTP_FROM_NAME="Voting Management System"
EMAIL_VERIFICATION_EXPIRES=24h
PASSWORD_RESET_EXPIRES=1h

# ============================================
# REDIS CONFIGURATION (Caching & Queue)
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_MAX_RETRIES=3
CACHE_TTL=3600

# ============================================
# STORAGE CONFIGURATION
# ============================================
STORAGE_TYPE="local" # local, s3, gcs, azure
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"
AWS_S3_ACCESS_KEY=""
AWS_S3_SECRET_KEY=""
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=52428800 # 50MB

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL="info" # debug, info, warn, error
LOG_FORMAT="json" # json, pretty
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=900000 # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS=true
SECURE_COOKIES=false # Set to true in production
TRUST_PROXY=false

# ============================================
# FEATURES FLAGS
# ============================================
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_BIOMETRIC_VOTING=false
FEATURE_BLOCKCHAIN_VERIFICATION=false
FEATURE_LIVE_RESULTS=true
FEATURE_ADVANCED_ANALYTICS=true

# ============================================
# ANALYTICS
# ============================================
POSTHOG_KEY=""
POSTHOG_ENDPOINT="https://app.posthog.com"

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ============================================
# PAGINATION & LIMITS
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DEFAULT_TIMEOUT=30000

# ============================================
# VOTING SYSTEM SETTINGS
# ============================================
ENABLE_ANONYMOUS_VOTING=false
ENABLE_RANKED_CHOICE=true
ENABLE_MULTI_SELECT=true
VOTING_SESSION_TIMEOUT=3600000 # 1 hour in ms
MAX_CANDIDATES_PER_ELECTION=100
MAX_VOTERS_PER_ELECTION=1000000

# ============================================
# API DOCUMENTATION
# ============================================
ENABLE_SWAGGER=true
SWAGGER_PATH="/api/docs"

# ============================================
# BACKUP & RECOVERY
# ============================================
ENABLE_BACKUPS=true
BACKUP_INTERVAL="0 2 * * *" # Every day at 2 AM
BACKUP_RETENTION_DAYS=30

# ============================================
# DEVELOPMENT ONLY
# ============================================
ENABLE_MOCK_DATA=false
DEBUG_API_RESPONSES=false
VERBOSE_LOGGING=false
SKIP_ENV_VALIDATION=false
